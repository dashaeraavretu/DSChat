{
  "name": "dschat",
  "version": "0.2.1",
  "description": "DSChat：基于 DeepSeek 开源 chat-demo 的跨平台桌面聊天客户端。",
  "license": "MIT",
  "author": "DSChat contributors",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "dev:desktop": "concurrently -k \"rspack serve -c rspack.config.ts\" \"wait-on tcp:8090 && cross-env DSCHAT_DEV=1 electron .\"",
    "build:web": "rimraf dist && cross-env NODE_ENV=production DSCHAT_DISPLAY_VERSION=0.2.1.1 rspack build -c rspack.config.ts",
    "build:test": "rimraf dist && cross-env NODE_ENV=production DSCHAT_PROFILE=qianji DSCHAT_DISPLAY_VERSION=0.2.1.1 rspack build -c rspack.config.ts",
    "build": "pnpm build:web",
    "start": "pnpm build && electron .",
    "smoke": "electron . --smoke",
    "smoke:blob": "electron . --smoke-blob",
    "icon": "node scripts/generate-icon.mjs",
    "dist:win": "pnpm build && electron-builder --win --config.win.artifactName=DSChat-0.2.1.1-x64.exe",
    "dist:test": "rimraf release-test && pnpm build:test && electron-builder --win --config.directories.output=release-test --config.win.artifactName=DSChat-0.2.1.1-qianji-test-x64.exe",
    "dist:dir": "pnpm build && electron-builder --win --dir",
    "type": "tsc -p tsconfig.json",
    "lint": "oxlint src rspack.config.ts",
    "format": "oxfmt --write ."
  },
  "dependencies": {
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "katex": "0.16.22",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/node": "~20.9.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "rimraf": "^6.1.4",
    "typescript": "7.0.2",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.dschat.desktop",
    "productName": "DSChat",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "!**/*.map",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSChat"
    }
  }
}
